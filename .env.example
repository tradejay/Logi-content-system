# ==============================================================================
# Environment Configuration Template for Logi-Content-System
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# 1. Logitech Support AI (Kapa RAG / Local Interface)
LOGITECH_AI_HOST=127.0.0.1
LOGITECH_AI_PORT=5050
LOGITECH_AI_ENDPOINT=http://127.0.0.1:5050/ask

# 2. Google Workspace & Search Logging
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=config/service_account.json

# 3. Naver Search & Blog Automation
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 4. Pipeline Execution Settings
PIPELINE_ENV=production
LOG_LEVEL=INFO
ENABLE_RELEASE_GATE=true
STRICT_FACT_VERIFICATION=true
